{
  "monitoring": {
    "enabled": true,
    "metrics_collection_interval": 5,
    "max_history_size": 1000,
    "prometheus_port": 8000,
    "health_check_thresholds": {
      "cpu_warning": 80,
      "cpu_critical": 90,
      "memory_warning": 80,
      "memory_critical": 90,
      "response_time_warning": 2000,
      "response_time_critical": 5000
    },
    "retention_days": 7
  },
  "logging": {
    "level": "INFO",
    "structured": true,
    "include_request_id": true
  }
}